# Flat node_modules so workspace packages can resolve the locally-linked
# `xxscreeps` types and shared dev tooling without per-package duplication.
node-linker=hoisted

# Do NOT auto-install the optional `xxscreeps` peer. Locally its types come from
# a built sibling checkout via the tsconfig `paths` mapping; in CI they fall back
# to the ambient shim in types/xxscreeps-shim.d.ts. Auto-installing the published
# xxscreeps sources would shadow both with a mismatched API and break the build.
auto-install-peers=false
