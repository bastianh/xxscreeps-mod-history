{
  "name": "screepsmod-history-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build && pnpm run copy-assets",
    "build:ci": "tsc --build --noCheck && pnpm run copy-assets",
    "copy-assets": "cp packages/core/config.schema.json packages/core/dist/config.schema.json",
    "clean": "tsc --build --clean",
    "watch": "tsc --build --watch",
    "test": "pnpm build && node --test \"packages/core/test/**/*.test.mjs\"",
    "test:ci": "pnpm build:ci && node --test \"packages/core/test/**/*.test.mjs\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:ci && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
